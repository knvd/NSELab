from cryptography.fernet import Fernet

def generate_key():
    """
    Generates a secure encryption key and saves it to 'secret.key'.
    """
    key = Fernet.generate_key()
    with open("secret.key", "wb") as key_file:
        key_file.write(key)
    print("Encryption key generated and saved to 'secret.key'.")

def load_key():
    """
    Loads the encryption key from 'secret.key'.
    Raises FileNotFoundError if the key file is missing.
    """
    try:
        with open("secret.key", "rb") as key_file:
            return key_file.read()
    except FileNotFoundError:
        raise FileNotFoundError("Key file not found. Please generate a key first.")

def encrypt_message(message):
    """
    Encrypts a string message using the loaded key.
    """
    if not isinstance(message, str) or not message.strip():
        raise ValueError("Message must be a non-empty string.")
    
    key = load_key()
    fernet = Fernet(key)
    encrypted = fernet.encrypt(message.encode())
    return encrypted

def decrypt_message(encrypted_message):
    """
    Decrypts an encrypted byte string using the loaded key.
    """
    if not isinstance(encrypted_message, (bytes, bytearray)):
        raise ValueError("Encrypted message must be bytes.")
    
    key = load_key()
    fernet = Fernet(key)
    try:
        decrypted = fernet.decrypt(encrypted_message)
        return decrypted.decode()
    except Exception:
        raise ValueError("Decryption failed. Invalid key or corrupted data.")

if __name__ == "__main__":
    print("=== Encryption & Decryption Program ===")
    print("1. Generate Key")
    print("2. Encrypt Message")
    print("3. Decrypt Message")
    
    choice = input("Enter choice (1/2/3): ").strip()
    
    try:
        if choice == "1":
            generate_key()
        
        elif choice == "2":
            msg = input("Enter message to encrypt: ")
            encrypted_data = encrypt_message(msg)
            print("Encrypted message (bytes):", encrypted_data)
        
        elif choice == "3":
            encrypted_input = input("Enter encrypted message (bytes format): ").encode()
            decrypted_data = decrypt_message(encrypted_input)
            print("Decrypted message:", decrypted_data)
        
        else:
            print("Invalid choice.")
    
    except Exception as e:
        print("Error:", e)
